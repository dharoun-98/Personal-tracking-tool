# ---------------------------------------------------------------------------
# Lifequest environment
#
# Copy to .env.local for local development, and set the same values in your
# Vercel project settings for production.
#
# The app runs with NONE of these set: the game is local-first, so it stays
# fully playable offline and without a backend. Each block below switches on
# one optional capability.
# ---------------------------------------------------------------------------

# Public site URL — metadata, Open Graph, and the auth redirect target.
# MUST match your real domain in production or email links will break.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the UI so you can tell which build you're looking at.
NEXT_PUBLIC_APP_VERSION=0.3.0


# --- Supabase: accounts, cloud backup, subscriptions -----------------------
# Supabase dashboard → Project Settings → API.
#
# Newer projects show "Publishable key" / "Secret keys"; older ones show
# "anon" / "service_role". Either naming works — set whichever pair you have.
#
# Before these do anything, run every numbered SQL file in
# supabase/migrations in filename order, then add your site URL under
# Authentication → URL Configuration:
#   Site URL:      https://your-domain
#   Redirect URLs: https://your-domain/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — it bypasses row-level security
# entirely and would be readable by anyone if it reached the browser.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=


# --- Email: report + promise letter delivery -------------------------------
RESEND_API_KEY=
EMAIL_FROM="Lifequest <hello@example.com>"


# --- Admin panel (/command-deck) -------------------------------------------
# Both are required before the admin route will do anything at all.
ADMIN_PASSWORD=
# Signs the admin session cookie. Must be at least 24 characters — the app
# refuses to enable admin below that rather than pretend to be secure.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=


# --- Stripe: billing after the 16-day trial --------------------------------
# Until STRIPE_SECRET_KEY is set, checkout returns a friendly 503 and the
# paywall says payments aren't switched on.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you point at /api/billing/webhook.
# Without it the webhook rejects everything — which is the safe default,
# since that route is the only thing allowed to mark an account as paid.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=


# --- Web push (Stage 4) ----------------------------------------------------
# Generate a key pair with no dependencies and no npx:
#   node docs/tooling/generate-vapid-keys.mjs
#
# The subject is NOT generated — it's a contact address required by the Web
# Push spec so push services can reach you about misbehaving notifications.
# Any mailbox you actually read.
#
# Generate once and keep them: changing the keys invalidates every existing
# subscription and everyone has to re-enable notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret between Supabase's hourly cron job and /api/push/dispatch.
# Without it the dispatcher refuses every request — which is the safe default,
# since that route can send to every user's phone. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value in migration 0004 where it says <CRON_SECRET>.
CRON_SECRET=
