# ---------------------------------------------------------------------------
# Lifequest environment
#
# Copy to .env.local and fill in. Stage 1 runs with NONE of these set: game
# state is local-first (localStorage), so the app is fully playable offline
# and without a backend. Everything below is wired up in later stages.
# ---------------------------------------------------------------------------

# Public site URL — used for metadata, Open Graph and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the UI so you can tell which build you're looking at.
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Supabase (Stage 3: accounts, cloud sync, subscriptions) ---------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Stage 2: report + promise letter delivery) --------------------
RESEND_API_KEY=
EMAIL_FROM="Lifequest <hello@example.com>"

# --- Admin panel (Stage 3) -------------------------------------------------
# Password for the /command-deck admin login. Use something long.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Web push (Stage 4) ----------------------------------------------------
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Stripe (Stage 3: billing after the 16-day trial) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=
